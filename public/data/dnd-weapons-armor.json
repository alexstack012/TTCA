  "weaponProperties": [
    {
      "id": "ammunition",
      "name": "Ammunition",
      "summary": "Requires matching ammunition; one piece is expended with each ranged attack."
    },
    {
      "id": "finesse",
      "name": "Finesse",
      "summary": "Use Strength or Dexterity for both attack and damage rolls."
    },
    {
      "id": "heavy",
      "name": "Heavy",
      "summary": "Small or Tiny creatures have disadvantage on attack rolls with the weapon."
    },
    {
      "id": "light",
      "name": "Light",
      "summary": "Suitable for two-weapon fighting."
    },
    {
      "id": "loading",
      "name": "Loading",
      "summary": "Only one piece of ammunition can be fired per action, bonus action, or reaction, regardless of extra attacks."
    },
    {
      "id": "reach",
      "name": "Reach",
      "summary": "Adds 5 feet to attack reach and opportunity-attack reach."
    },
    {
      "id": "special",
      "name": "Special",
      "summary": "Uses an item-specific rule."
    },
    {
      "id": "thrown",
      "name": "Thrown",
      "summary": "Can make a ranged attack using the same ability normally used for its melee attack."
    },
    {
      "id": "two-handed",
      "name": "Two-Handed",
      "summary": "Requires two hands when making an attack."
    },
    {
      "id": "versatile",
      "name": "Versatile",
      "summary": "Can be used one- or two-handed; two-handed damage is stored separately."
    }
  ],
