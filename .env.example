PORT=3000
CLIENT_ORIGIN=http://localhost:4200
# Set to 1 when Express is behind one trusted reverse proxy.
# TRUST_PROXY=1
ADMIN_PASSWORD=example_password
SESSION_SECRET=replace-with-at-least-32-random-characters
PGHOST=localhost
PGPORT=5432
PGDATABASE=dnd_campaign_log
PGUSER=dnd_app
PGPASSWORD=replace-with-the-password-for-dnd_app
# Hosted deployments may use DATABASE_URL instead of the five PG* settings above.
# DATABASE_URL=postgresql://dnd_app:password@host:5432/dnd_campaign_log
# Optional schema-owner connection used only by `npm run db:migrate`.
# MIGRATION_DATABASE_URL=postgresql://migration_owner:password@host:5432/dnd_campaign_log
DATABASE_SSL=false
# Set to false only when a hosted provider requires SSL with a self-signed certificate.
DATABASE_SSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=30000
PG_STATEMENT_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=20000
