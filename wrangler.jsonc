{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ttca",
  "compatibility_date": "2026-08-11",
  "main": "./worker/index.js",
  "keep_vars": true,

  "assets": {
    "directory": "./dist/TTCA/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
}
